# Application Environment Variables
# Configure secrets in AI Studio Secrets panel or your deployment platform (Vercel / Supabase).
# NEVER commit real production secrets or service role keys to source control.

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Gemini AI API Key (if AI features are enabled)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
